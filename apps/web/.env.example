# PocketBase URL used by the browser client. The Docker/local run scripts
# serve PocketBase on :8080; code defaults to :8090 (a bare `go run . serve`
# with no --http flag) — confirm which one is actually running.
VITE_POCKETBASE_URL=http://127.0.0.1:8080

# Optional: PocketBase URL for server functions (SSR, running on the
# Cloudflare Worker) when it differs from the browser's — e.g. the Worker
# reaches PocketBase over a private/internal hostname the browser can't
# resolve. Falls back to VITE_POCKETBASE_URL when unset.
# POCKETBASE_URL=http://127.0.0.1:8090

# Superuser credentials for the endorsement e-signature sign flow
# (apps/web/src/lib/server/endorsement-signatures.ts). Used server-only, to
# read/write a specific endorsement record when a CFI opens a single-use
# sign link with no PocketBase session of their own — never sent to the
# browser. Create a superuser via `go run . superuser upsert <email>
# <password>` in pocketbase/base.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
