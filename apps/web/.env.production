# Vite substitutes import.meta.env.VITE_* at build time — the `vars` block
# in wrangler.jsonc only sets Workers *runtime* bindings and has no effect
# on the `vite build` step, so `VITE_POCKETBASE_URL` must also be set here
# or the production bundle falls back to the http://127.0.0.1:8080 default
# in src/lib/pocketbase.ts. Vite loads this file automatically for
# production builds (`npm run deploy` / `vite build`).
VITE_POCKETBASE_URL=https://openfly.dokku.westmorelandcreative.com
